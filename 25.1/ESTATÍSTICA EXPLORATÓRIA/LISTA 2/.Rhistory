dados <- data.frame(
Regiao = c("São Paulo", "Rio de Janeiro", "Belém", "Belo Horizonte", "Salvador", "Porto Alegre", "Recife", "Fortaleza"),
Setor_Primario = c(2.0, 2.5, 2.9, 3.3, 4.1, 4.3, 7.0, 13.0),
Analfabetismo = c(17.5, 18.5, 19.5, 22.2, 26.5, 16.6, 36.6, 38.4)
)
library(ggplot2)
ggplot(dados, aes(x = Setor_Primario, y = Analfabetismo)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(title = "Relação entre Setor Primário e Analfabetismo")
View(dados)
